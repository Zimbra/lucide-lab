{
  "name": "@zimbra/lucide-lab",
  "description": "Zimbra Lucide lab is a project with custom icons designed for zimbra.",
  "version": "0.1.2",
  "license": "ISC",
  "homepage": "https://github.com/Zimbra/lucide-lab/",
  "bugs": "https://github.com/Zimbra/lucide-lab/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/Zimbra/lucide-lab.git"
  },
  "keywords": [
    "Lucide",
    "Feather",
    "Icons",
    "Icon",
    "SVG",
    "Feather Icons",
    "Fontawesome",
    "Font Awesome"
  ],
  "source": "src/lucide-lab.js",
  "main": "dist/cjs/lucide-lab.js",
  "module": "dist/esm/lucide-lab.js",
  "typings": "dist/lucide-lab.d.ts",
  "sideEffects": false,
  "scripts": {
    "copy:license": "cp ../../LICENSE ./LICENSE",
    "build": "npm run clean && npm run copy:license && npm run build:icons && npm run build:bundle && npm run build:lib",
    "build:icons": "build-icons --output=./src --templateSrc=./scripts/exportTemplate.mjs --iconFileExtension=.ts --withAliases --exportModuleNameCasing=camel --renderUniqueKey --aliasNamesOnly --aliasesFileExtension=.ts --exportFileName=index.ts",
    "build:lib": "node ./scripts/buildLib.mjs",
    "build:bundle": "rollup -c rollup.config.mjs",
    "clean": "rm -f src/icons/*.ts && rm -rf dist",
    "version": "npm run version --git-tag-version=false",
    "prepublishOnly": "npm run build && git commit -am $npm_package_version && git tag $npm_package_version && git push && git push --tags"
  },
  "devDependencies": {
    "@lucide/rollup-plugins": "1.0.0",
    "minimist": "^1.2.8",
    "prettier": "^2.3.2",
    "rollup": "^4.9.2",
    "rollup-plugin-dts": "^6.1.0",
    "svgson": "^5.2.1"
  }
}
